[Unit]
Description=Sync calendars into the Omarchy calendar widget
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# A user service starts with a minimal PATH, so tools installed by pip,
# bun, cargo or pipx would be invisible. This list covers the usual spots.
Environment=PATH=%h/.local/bin:%h/.cache/.bun/bin:%h/.bun/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
# Default backend is vdirsyncer (no Google account needed). To use the
# gws backend instead, drop the --source flag and point at your own client.
ExecStart=%h/.config/omarchy/plugins/antoniodavid.calendar/sync/omarchy-calendar-sync --source vdirsyncer
# A failed run is deliberately allowed to surface as a failed unit. The
# sync leaves the previous events file intact either way, and a user
# needs `systemctl --user status` to show that something is wrong.
