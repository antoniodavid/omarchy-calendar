{
  "schemaVersion": 1,
  "id": "antoniodavid.calendar",
  "name": "Calendar",
  "version": "0.3.0",
  "author": "antoniodavid",
  "license": "MIT",
  "description": "Your calendar in the bar, synced from vdirsyncer (no Google account needed).",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Calendar",
    "description": "Your calendar in the bar. Your next meeting at a glance, and one click to join it. Syncs via vdirsyncer or the Google Workspace CLI.",
    "category": "Time",
    "allowMultiple": false,
    "defaults": {
      "format": "dddd HH:mm",
      "formatAlt": "d MMMM 'W'ww yyyy",
      "verticalFormat": "HH\n-\nmm"
    },
    "schema": [
      {
        "key": "format",
        "type": "string",
        "label": "Date format",
        "defaultValue": "dddd HH:mm"
      },
      {
        "key": "formatAlt",
        "type": "string",
        "label": "Alternate format",
        "defaultValue": "d MMMM 'W'ww yyyy"
      },
      {
        "key": "verticalFormat",
        "type": "string",
        "label": "Vertical bar format",
        "defaultValue": "HH\n-\nmm"
      },
      {
        "key": "birthYear",
        "type": "number",
        "label": "Birth year",
        "defaultValue": 0
      },
      {
        "key": "lifeExpectancy",
        "type": "number",
        "label": "Life expectancy",
        "defaultValue": 0
      }
    ]
  }
}
